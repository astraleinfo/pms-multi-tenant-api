# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
#
# APP role is the one every request runs as. It must NOT be the table owner and
# must NOT have BYPASSRLS — row-level security is what stops one clinic reading
# another. `scripts/bootstrap_db.sql` creates both roles correctly.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pms_app:app-password-change-me@localhost:55432/pms
# Owner/migration role. Only alembic and the seeder use it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://pms_owner:owner-password-change-me@localhost:55432/pms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Tenancy — the host a request arrives on decides the tenant
# ---------------------------------------------------------------------------
# Apex domain. `northgate.<APP_DOMAIN>` is a clinic, `admin.<APP_DOMAIN>` is the
# super-admin console, and the apex itself is neither.
APP_DOMAIN=localhost
# The label the console is served on. Always a reserved subdomain.
ADMIN_HOST_LABEL=admin
# Origins allowed by CORS beyond the computed tenant origins (comma separated).
EXTRA_CORS_ORIGINS=
# Scheme + port the browser uses, so cookies and links are built correctly.
# Leave PUBLIC_PORT blank behind a proxy on 443/80: links then carry no port.
PUBLIC_SCHEME=http
PUBLIC_PORT=3000

# ---------------------------------------------------------------------------
# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-this-value-is-not-a-secret
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days
MAX_FAILED_LOGINS=5
COOKIE_SECURE=false                   # must be true anywhere but local http
# e.g. .astrale.health so subdomains share the refresh cookie. Leave blank for local dev.
COOKIE_DOMAIN=
# The path the browser sends the refresh cookie back to. Behind a proxy that
# mounts this API at /api, that is /api/v1/auth — not /v1/auth.
REFRESH_COOKIE_PATH=/

# ---------------------------------------------------------------------------
# Rate limits (per client IP)
# ---------------------------------------------------------------------------
ALLOW_TENANT_HEADER=false        # dev only: let X-Tenant-Slug stand in for the subdomain
LOGIN_RATE_LIMIT=10/minute
PASSWORD_RESET_RATE_LIMIT=5/hour

# --- invitations and transactional email -----------------------------------
# Nobody is handed a password: an account is created without one and its owner
# is emailed a single-use link to choose their own. These links are the only
# way into a new clinic, so a deployment with no working transport is a
# deployment nobody can sign in to — `console` is refused in production.
#
#   console  writes the message, link and all, to the Celery worker's log
#            (development) — the worker is what sends every email
#   smtp     hands it to a real server
#   ses      sends through Amazon SES (uses the AWS settings below). MAIL_FROM
#            must be an identity verified in SES_REGION, and while the account
#            is in the SES sandbox every recipient must be verified too.
MAIL_PROVIDER=console
MAIL_FROM=Astrale PMS <no-reply@astrale.health>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Blank means AWS_REGION.
SES_REGION=
# Optional: an SES configuration set for bounce/complaint/delivery events.
SES_CONFIGURATION_SET=

# ---------------------------------------------------------------------------
# AWS — shared by S3 storage and SES email
#
# Leave the keys blank on AWS itself and give the instance/task a role instead;
# boto3 then finds credentials on its own (role, ~/.aws, or the environment).
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# File storage — lab reports and scans
#
#   database  bytes are kept in the row, under the same RLS as the order
#   s3        bytes go to S3_BUCKET; the row keeps the object key
#
# Reads follow the row, so switching backend does not strand older files.
# The bucket should block all public access; nothing but this API reads it.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=database
S3_BUCKET=
# Blank means AWS_REGION.
S3_REGION=
# Only for an S3-compatible store (MinIO, Cloudflare R2, ...). Blank for AWS.
S3_ENDPOINT_URL=
S3_PREFIX=pms
# AES256, aws:kms (with S3_KMS_KEY_ID), or blank for the bucket default.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

API_RATE_LIMIT=600/minute

# ---------------------------------------------------------------------------
# Patient messaging
#
# The outbox worker sends booking confirmations, appointment notices and
# follow-ups.
# The `messages` row is the source of truth; Redis only carries a wake-up, so
# losing Redis delays delivery but never loses a message.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# How many attempts before a message is parked as failed.
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_RETRY_BASE_SECONDS=30
# How often the worker sweeps for due and stranded messages.
WORKER_POLL_SECONDS=10
# Encrypts provider credentials at rest. Defaults to a key derived from
# JWT_SECRET; set your own so rotating JWT_SECRET does not invalidate them.
SECRETS_KEY=

# ---------------------------------------------------------------------------
# Support desk and background jobs (Celery)
#
# Every email is the Celery worker's: invitations and password resets (the
# worker mints the link itself, so it never sits in Redis), and support
# requests, emailed to SUPPORT_EMAIL — all through the MAIL_PROVIDER above. Jobs
# are acked late and re-queued if a worker dies. Nothing retries on a timer: a
# send that fails, or a job the broker never got, shows Resend on the person's
# row, Retry on the console's support requests, or Retry in the import dialog.
# Without a worker running, nobody receives an invitation. Run both:
#   celery -A app.worker.celery_app worker -Q pms --loglevel=INFO -E  (--pool=solo on Windows)
#   celery -A app.worker.celery_app beat --loglevel=INFO
# ---------------------------------------------------------------------------
SUPPORT_EMAIL=astraleinfo@gmail.com
# Blank means REDIS_URL.
CELERY_BROKER_URL=

# ---------------------------------------------------------------------------
# Background-job monitoring (Flower)
#
# The super-admin console's Background jobs section reads Flower, which is
# subscribed to Celery's event stream and keeps the task history in memory.
#
# Flower's port is never published. It answers on the container network, and
# the only way to it from outside is /v1/platform/jobs/..., which refuses
# anyone who is not a platform super admin — a clinic session of any role gets
# 403, and so does a platform account whose role is `support`. Do not add a
# `ports:` entry for it, and do not put it behind its own hostname.
#
#   celery -A app.worker.celery_app flower --port=5555 \
#       --url_prefix=v1/platform/jobs/flower --basic_auth=user:password
#
# FLOWER_URL_PREFIX has to be the path the *browser* uses, because Flower
# builds its own links from it and the API forwards to the same one. Reached
# directly, that is `v1/platform/jobs/flower`; behind a proxy serving this API
# under /api — which is what the web app does — it is
# `api/v1/platform/jobs/flower`. Set the same value on both containers.
#
# FLOWER_BASIC_AUTH is not optional in production: a private network is not a
# credential, and without it anything else on that network reads every job's
# arguments. Turn FLOWER_ENABLED off instead if you run no monitor — the routes
# stay, still refuse everyone but a super admin, and report it as unavailable.
# ---------------------------------------------------------------------------
FLOWER_ENABLED=true
FLOWER_URL=http://flower:5555
# The web app serves this API under /api, so that is the prefix here. Drop
# the `api/` if a client reaches the API at the root instead.
FLOWER_URL_PREFIX=api/v1/platform/jobs/flower
FLOWER_BASIC_AUTH=
FLOWER_TIMEOUT_SECONDS=10
# How long a browser may keep the (HttpOnly, scoped) cookie that lets it load
# Flower's own pages. The console mints a new one each time it opens the tab.
FLOWER_SESSION_TTL_SECONDS=900
# Same trap as REFRESH_COOKIE_PATH: it must match the path the browser uses.
FLOWER_COOKIE_PATH=/
# How many task records one screen is counted over. Flower's history is
# bounded, and the console prints this figure beside the totals.
FLOWER_TASK_WINDOW=500
# How often to make Flower re-inspect the workers. It inspects once at startup
# and never again unless asked, and in a container set it usually starts before
# any worker exists — so without this the concurrency and queue columns stay
# empty. It is a ping to every worker, hence a throttle rather than every poll.
FLOWER_INSPECT_SECONDS=30

# ---------------------------------------------------------------------------
# Subscription rent — what each clinic pays the platform
#
# A bill is raised on the first run of each month for every active, non-exempt
# clinic: one line, the flat monthly clinic fee, which covers every module. The
# fee, when it is due, how long the grace period is, and when the
# reminder ladder starts are all configured in /platform/settings (see
# app/services/platform.py::Timings) — editable from the console, not env vars.
#
# Off by default — switched on, the beat bills every clinic, demo ones included.
# "Run billing now" in the console works either way; exempt internal clinics
# there first.
# ---------------------------------------------------------------------------
RENT_BILLING_ENABLED=false
RENT_CURRENCY=INR
RENT_CYCLE_SECONDS=3600

# ---------------------------------------------------------------------------
# Error reporting — where unexpected errors go besides the log
#
# Every line logged at ERROR or above is a report: an unhandled 500, a Celery
# task that raised, a worker loop that caught a bug and carried on. The code
# only ever logs, so switching service is these settings and nothing else.
#
#   none    the log only (development, tests)
#   sentry  sent to the Sentry project SENTRY_DSN names
#
# Only ENVIRONMENT=production reports. Development, staging and the tests
# report nothing, whatever ERROR_REPORTER and SENTRY_DSN say.
#
# Reports carry identifiers — request, clinic, user, path — never patient data.
# The Sentry adapter turns off PII, stack-frame locals and request bodies.
# ---------------------------------------------------------------------------
ERROR_REPORTER=none
SENTRY_DSN=
# A version or git sha, set by the deploy, so an error is pinned to a release.
APP_RELEASE=
