# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
#
# APP role is the one every request runs as. It must NOT be the table owner and
# must NOT have BYPASSRLS — row-level security is what stops one clinic reading
# another. `scripts/bootstrap_db.sql` creates both roles correctly.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pms_app:app-password-change-me@localhost:55432/pms
# Owner/migration role. Only alembic and the seeder use it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://pms_owner:owner-password-change-me@localhost:55432/pms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Tenancy — the host a request arrives on decides the tenant
# ---------------------------------------------------------------------------
# Apex domain. `northgate.<APP_DOMAIN>` is a clinic, `admin.<APP_DOMAIN>` is the
# super-admin console, and the apex itself is neither.
APP_DOMAIN=localhost
# The label the console is served on. Always a reserved subdomain.
ADMIN_HOST_LABEL=admin
# Origins allowed by CORS beyond the computed tenant origins (comma separated).
EXTRA_CORS_ORIGINS=
# Scheme + port the browser uses, so cookies and links are built correctly.
PUBLIC_SCHEME=http
PUBLIC_PORT=3000

# ---------------------------------------------------------------------------
# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-this-value-is-not-a-secret
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days
MAX_FAILED_LOGINS=5
COOKIE_SECURE=false                   # must be true anywhere but local http
# e.g. .astrale.health so subdomains share the refresh cookie. Leave blank for local dev.
COOKIE_DOMAIN=
# The path the browser sends the refresh cookie back to. Behind a proxy that
# mounts this API at /api, that is /api/v1/auth — not /v1/auth.
REFRESH_COOKIE_PATH=/

# ---------------------------------------------------------------------------
# Rate limits (per client IP)
# ---------------------------------------------------------------------------
ALLOW_TENANT_HEADER=false        # dev only: let X-Tenant-Slug stand in for the subdomain
LOGIN_RATE_LIMIT=10/minute
PASSWORD_RESET_RATE_LIMIT=5/hour

# --- invitations and transactional email -----------------------------------
# Nobody is handed a password: an account is created without one and its owner
# is emailed a single-use link to choose their own. These links are the only
# way into a new clinic, so a deployment with no working transport is a
# deployment nobody can sign in to — `console` is refused in production.
#
#   console  writes the message, link and all, to the log (development)
#   smtp     hands it to a real server
MAIL_PROVIDER=console
MAIL_FROM=Astrale PMS <no-reply@astrale.health>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# How long a link stays usable. An invitation is long enough for a clinic to
# act in its own time; a reset is short, because one sitting in an inbox
# should not be a standing key.
INVITE_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=7200
API_RATE_LIMIT=600/minute

# ---------------------------------------------------------------------------
# Patient messaging
#
# The outbox worker sends booking confirmations, reminders and follow-ups.
# The `messages` row is the source of truth; Redis only carries a wake-up, so
# losing Redis delays delivery but never loses a message.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# How many attempts before a message is parked as failed.
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_RETRY_BASE_SECONDS=30
# How often the worker sweeps for due and stranded messages.
WORKER_POLL_SECONDS=10
# Reminders go out this many hours before the slot, in the clinic's timezone.
REMINDER_LEAD_HOURS=24
# Encrypts provider credentials at rest. Defaults to a key derived from
# JWT_SECRET; set your own so rotating JWT_SECRET does not invalidate them.
SECRETS_KEY=

# ---------------------------------------------------------------------------
# Platform billing — what a clinic pays *us*
#
# Not to be confused with the clinic's own patient billing, which is configured
# per clinic in the app (tax_pct, invoice_prefix, payment terms). This is the
# platform's subscription ledger, and none of the settings below is a price:
# every amount the product charges lives in the `plans`, `plan_features` and
# `tax_rates` tables. A deployment that wants different prices, a different
# plan mix, or a different tax regime writes rows — it does not edit this file,
# and it does not edit any code.
# ---------------------------------------------------------------------------
BILLING_ENABLED=true
# Which adapter new subscriptions are created against. `manual` is a supported
# state, not a degraded one: invoices are still raised and totals are still
# right, and the money arrives by bank transfer.
BILLING_GATEWAY=razorpay
# Printed in front of the platform-wide invoice sequence: AST-202609-001042.
BILLING_INVOICE_PREFIX=AST
# How long a clinic has to pay before an invoice is chased.
BILLING_PAYMENT_TERMS_DAYS=7
# How long past due before the subscription is flagged `past_due`. Nothing is
# switched off — suspending a clinic is a deliberate act by a person, never a
# cron job's decision.
BILLING_GRACE_DAYS=7
# The state or region the platform bills *from*. Only consulted when the
# `tax_rates` table distinguishes intra-state from inter-state supplies; a
# deployment whose rates are all `any` never reads it.
BILLING_SUPPLIER_REGION=
# Where the "Pay Now" button points when the gateway has not minted a hosted
# page. Always a path on the clinic's own origin, built from configuration.
BILLING_PORTAL_PATH=/settings/billing
# How often the billing worker sweeps. Billing work is daily-to-hourly and
# idempotent, so this is a floor on latency rather than on correctness.
BILLING_POLL_SECONDS=60
# A webhook that keeps failing is parked after this many attempts, so one
# poisonous payload cannot bury the deliveries behind it.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=30

# --- Razorpay ---------------------------------------------------------------
# KEY_ID is the public half of the pair and is the only credential value that
# ever reaches a browser — Checkout needs it. The secret signs API calls and
# verifies what Checkout hands back; the webhook secret verifies deliveries.
# Neither ever leaves the process, appears in a response, or is logged.
#
# A production deployment with BILLING_GATEWAY=razorpay refuses to start
# without all three (see `validate_for_production`): taking orders you cannot
# collect is bad, and accepting webhooks you cannot verify is worse.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=20
