# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
#
# APP role is the one every request runs as. It must NOT be the table owner and
# must NOT have BYPASSRLS — row-level security is what stops one clinic reading
# another. `scripts/bootstrap_db.sql` creates both roles correctly.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pms_app:app-password-change-me@localhost:55432/pms
# Owner/migration role. Only alembic and the seeder use it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://pms_owner:owner-password-change-me@localhost:55432/pms
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Tenancy — the host a request arrives on decides the tenant
# ---------------------------------------------------------------------------
# Apex domain. `northgate.<APP_DOMAIN>` is a clinic, `admin.<APP_DOMAIN>` is the
# super-admin console, and the apex itself is neither.
APP_DOMAIN=localhost
# The label the console is served on. Always a reserved subdomain.
ADMIN_HOST_LABEL=admin
# Origins allowed by CORS beyond the computed tenant origins (comma separated).
EXTRA_CORS_ORIGINS=
# Scheme + port the browser uses, so cookies and links are built correctly.
PUBLIC_SCHEME=http
PUBLIC_PORT=3000

# ---------------------------------------------------------------------------
# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-this-value-is-not-a-secret
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days
MAX_FAILED_LOGINS=5
COOKIE_SECURE=false                   # must be true anywhere but local http
COOKIE_DOMAIN=                        # e.g. .astrale.health so subdomains share the refresh cookie
# The path the browser sends the refresh cookie back to. Behind a proxy that
# mounts this API at /api, that is /api/v1/auth — not /v1/auth.
REFRESH_COOKIE_PATH=/

# ---------------------------------------------------------------------------
# Rate limits (per client IP)
# ---------------------------------------------------------------------------
ALLOW_TENANT_HEADER=false        # dev only: let X-Tenant-Slug stand in for the subdomain
LOGIN_RATE_LIMIT=10/minute
PASSWORD_RESET_RATE_LIMIT=5/hour

# --- invitations and transactional email -----------------------------------
# Nobody is handed a password: an account is created without one and its owner
# is emailed a single-use link to choose their own. These links are the only
# way into a new clinic, so a deployment with no working transport is a
# deployment nobody can sign in to — `console` is refused in production.
#
#   console  writes the message, link and all, to the log (development)
#   smtp     hands it to a real server
MAIL_PROVIDER=console
MAIL_FROM=Astrale PMS <no-reply@astrale.health>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# How long a link stays usable. An invitation is long enough for a clinic to
# act in its own time; a reset is short, because one sitting in an inbox
# should not be a standing key.
INVITE_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=7200
API_RATE_LIMIT=600/minute

# ---------------------------------------------------------------------------
# Patient messaging
#
# The outbox worker sends booking confirmations, reminders and follow-ups.
# The `messages` row is the source of truth; Redis only carries a wake-up, so
# losing Redis delays delivery but never loses a message.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# How many attempts before a message is parked as failed.
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_RETRY_BASE_SECONDS=30
# How often the worker sweeps for due and stranded messages.
WORKER_POLL_SECONDS=10
# Reminders go out this many hours before the slot, in the clinic's timezone.
REMINDER_LEAD_HOURS=24
# Encrypts provider credentials at rest. Defaults to a key derived from
# JWT_SECRET; set your own so rotating JWT_SECRET does not invalidate them.
SECRETS_KEY=
