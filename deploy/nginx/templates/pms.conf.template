# Rendered by the nginx image's entrypoint (envsubst) into conf.d/pms.conf.
# Only variables set in the container's environment are substituted, so
# nginx's own $host, $uri, … pass through untouched.
#
#   APP_DOMAIN     the apex, e.g. astrale.health — clinics are <slug>.APP_DOMAIN
#   API_UPSTREAM   host:port of the API container, e.g. api:8000
#   WEB_UPSTREAM   host:port of the web app,       e.g. web:3000
#
# Certificates: one wildcard certificate covering APP_DOMAIN and *.APP_DOMAIN,
# mounted at /etc/nginx/certs/{fullchain,privkey}.pem. A wildcard needs the
# DNS-01 challenge, so it is issued outside this container (certbot with a DNS
# plugin, or your provider) and nginx is reloaded when it renews.

# Re-resolve service names, so a recreated container with a new address is
# picked up without restarting nginx. NGINX_LOCAL_RESOLVERS is filled in by
# the image when NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 5s;

upstream pms_api {
    zone pms_api 64k;
    # One server, deliberately: the API runs a single process (see the
    # Dockerfile) until its event broker moves to Redis.
    server ${API_UPSTREAM} resolve max_fails=0;
    keepalive 32;
    keepalive_timeout 60s;
}

upstream pms_web {
    zone pms_web 64k;
    server ${WEB_UPSTREAM} resolve max_fails=0;
    keepalive 32;
    keepalive_timeout 60s;
}

# ------------------------------------------------------------ catch-alls
# A Host that is not ours gets nothing — no tenant guessing via arbitrary
# Host headers, no serving the site under someone else's domain.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # For a load balancer's health check, which usually sends a bare IP as Host.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# ------------------------------------------------------- http -> https
server {
    listen 80;
    listen [::]:80;
    server_name .${APP_DOMAIN};

    location / {
        return 308 https://$host$request_uri;
    }
}

# ------------------------------------------------- the apex and clinics
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    # `.domain` is the apex and every subdomain: admin., and each <slug>.
    server_name .${APP_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Lab attachments are capped at 15 MB by the API; multipart adds a little.
    client_max_body_size 20m;

    limit_conn rl_conn 100;

    # Server-level headers only — an add_header inside a location would drop
    # all of these for that location. The API sets the rest of its security
    # headers itself; HSTS is set here, once, for the web app's pages too.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Request-ID $pms_request_id always;

    # Shared by every proxied location below.
    proxy_http_version 1.1;
    # Host intact: the subdomain is how a request names its clinic.
    proxy_set_header Host              $host;
    # Overwritten, not appended: uvicorn trusts this header, so a client must
    # not be able to seed it. ($remote_addr is already the real client when
    # real_ip_* is configured in nginx.conf.)
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Request-ID      $pms_request_id;
    # Set here and nowhere else: a proxy_set_header inside a location would
    # discard every one above for that location — Host included. The map in
    # nginx.conf yields "upgrade" for a WebSocket handshake and "" otherwise,
    # which keeps ordinary requests on pooled keepalive connections.
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    120s;
    # Retry only when the request never reached the API; never replay a POST.
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
    # The API sends HSTS itself when COOKIE_SECURE is on; keep the one above.
    proxy_hide_header Strict-Transport-Security;

    # ----------------------------------------------------------- the API
    # /api/... is the API at /... — the trailing slash on proxy_pass strips the
    # prefix. Flower's links are built for this prefix too
    # (FLOWER_URL_PREFIX=api/v1/platform/jobs/flower).
    location /api/ {
        limit_req zone=rl_api burst=100 nodelay;
        proxy_pass http://pms_api/;
    }

    # Sign-in, refresh, password reset. Tighter limit, and no compression on
    # responses that carry tokens (BREACH).
    location /api/v1/auth/ {
        limit_req zone=rl_auth burst=30 nodelay;
        limit_req zone=rl_api  burst=100 nodelay;
        gzip off;
        proxy_pass http://pms_api/v1/auth/;
    }

    # The live queue. Long-lived; the API heartbeats every 25s, so a read
    # timeout of a few minutes only ever closes a socket that is truly dead.
    location /api/v1/ws/ {
        limit_req zone=rl_api burst=100 nodelay;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;

        proxy_pass http://pms_api/v1/ws/;
    }

    # Liveness/readiness belong to the orchestrator, not the internet.
    location ~ ^/api/health(/|$) {
        return 404;
    }

    # ------------------------------------------------------- the web app
    location / {
        proxy_pass http://pms_web;
    }
}
